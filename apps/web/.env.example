# Copy to .env for local development: cp .env.example .env

# Public URL of the site, used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# On Vercel it falls back to the project's production domain when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:4710

# Origin of the Glitch Craft API. Server-side only: never exposed to the browser.
# Leave unset to deploy the site without the API: the contact form then prepares an
# email draft instead of submitting. `bun run dev` defaults it to http://localhost:4711.
API_URL=http://localhost:4711
