# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
HOST=0.0.0.0
PORT=4711

# Matches the `db` service in compose.yaml (bun run db:up).
DATABASE_URL=postgres://glitchcraft:glitchcraft@localhost:4712/glitchcraft

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:4710

# Express "trust proxy" setting: true/false, a hop count, or a list of trusted
# subnets/presets. The web app forwards the visitor IP in X-Forwarded-For so
# rate limiting applies per visitor.
TRUST_PROXY=loopback, linklocal, uniquelocal
